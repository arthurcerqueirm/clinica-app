# Copie este arquivo para .env.local e preencha os valores.
# Ver PLANO.md — Apêndice B e Fase 0 para onde obter cada chave.

# ── Público (vai no bundle do frontend) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Servidor apenas (NUNCA prefixar com NEXT_PUBLIC_) ───
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@clinica.com.br

# ── Configuração ────────────────────────────────────────
TZ=America/Sao_Paulo

# ── Login automático (dev, opcional) ────────────────────
# Se preenchido, pula a tela de login em desenvolvimento (nunca ativa em
# produção, mesmo que essas variáveis estejam setadas — ver lib/supabase/middleware.ts).
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=
